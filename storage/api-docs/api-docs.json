                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "post": {
                "tags": [
                    "Pembayaran"
                ],
                "summary": "Process payment",
                "description": "Process student payment for a bill",
                "operationId": "11c45bdb8fd2b68b4335cf74986bcc6f",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "tagihan_siswa_id",
                                    "jumlah_bayar"
                                ],
                                "properties": {
                                    "tagihan_siswa_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "jumlah_bayar": {
                                        "type": "integer",
                                        "example": 500000
                                    },
                                    "metode": {
                                        "description": "CASH, TRANSFER, QRIS, etc",
                                        "type": "string",
                                        "example": "CASH"
                                    },
                                    "keterangan": {
                                        "type": "string",
                                        "example": "Pembayaran SPP Januari 2024"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Payment successful"
                    },
                    "400": {
                        "description": "Validation error or bill already paid"
                    },
                    "500": {
                        "description": "Internal server error"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
