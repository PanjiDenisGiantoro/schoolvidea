# Docker Environment Configuration
# =================================

# Application
APP_NAME=SchoolVidea
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Locale
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database - PostgreSQL Master
DB_CONNECTION=pgsql
DB_HOST=postgres-master
DB_PORT=5432
DB_DATABASE=laravel
DB_USERNAME=postgres
DB_PASSWORD=password

# Database - PostgreSQL Slave (Read Replica)
DB_SLAVE_HOST=postgres-slave
DB_SLAVE_PORT=5432

# Database Credentials (used by docker-compose)
DB_NAME=laravel
DB_USER=postgres

# Replication Settings
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replication_password

# Redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Cache & Session
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=redis

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Mail (configure as needed)
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Vite
VITE_APP_NAME="${APP_NAME}"
